{
  "name": "fleet-test-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:migrate": "tsx database/migrate.ts",
    "db:seed": "tsx database/seed.ts",
    "db:reset-demo": "tsx database/reset-demo.ts --confirm-demo-data-reset",
    "test:contracts": "vitest run packages/contracts/test",
    "test:db": "vitest run database/test",
    "test:api": "vitest run apps/api/test",
    "test:web": "vitest run apps/web/src",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "build": "npm run build -w @fleet/contracts && npm run build -w @fleet/api && npm run build -w @fleet/web",
    "dev": "concurrently -k \"npm run dev -w @fleet/contracts\" \"npm run dev -w @fleet/api\" \"npm run dev -w @fleet/web\"",
    "start": "node --env-file=.env apps/api/dist/server.js",
    "test:e2e": "playwright test",
    "test:smoke": "tsx tests/production-smoke.ts",
    "prepare": "npm run build -w @fleet/contracts",
    "predev": "npm run build -w @fleet/contracts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
